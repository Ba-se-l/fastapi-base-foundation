# ———————— Application ————————
APP_TITLE=FastAPI Base Structure
APP_VERSION=1.0.0
APP_DESCRIPTION=Your project description here

# ———————— Server ————————
HOST=127.0.0.1
PORT=8000
RELOAD=false
ENVIRONMENT=dev  # dev | test | staging | pro | prod

# ———————— Security & Documentation Perimeter ————————
# Defaults to true in dev/test, false in staging/pro/prod
# ENABLE_DOCS_AND_UI=true
# ALLOW_PUBLIC_REGISTRATION=true
SECURITY_HEADERS_ENABLED=true

# ———————— CORS ————————
# JSON array of allowed origins. Wildcard ["*"] is strictly prohibited in staging/pro/prod.
ALLOWED_ORIGINS=["http://localhost:3000","http://127.0.0.1:8000"]
ALLOWED_HEADERS=["*"]
ALLOW_METHODS=["GET","POST","PATCH","DELETE"]

# ———————— Database ————————
# SQLite (dev):
DATABASE_URL=sqlite+aiosqlite:///./database.db
# PostgreSQL (pro):
# DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/dbname
ECHO=false

# ———————— JWT Secrets ————————
# CRITICAL: In staging/prod, secrets MUST be explicitly set, length >= 32, with >= 10 distinct characters!
# In dev/test, omission automatically generates secure transient keys in memory.
ACCESS_SECRET_KEY=replace-with-a-very-long-high-entropy-access-secret-32ch!
REFRESH_SECRET_KEY=replace-with-a-very-long-high-entropy-refresh-secret-32ch!
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRES_MINUTES=30
REFRESH_TOKEN_EXPIRES_DAYS=30

# ———————— Auth Transport & Cookies ————————
AUTH_TRANSPORT_MODE=dual  # dual | cookie | json
REFRESH_COOKIE_NAME=refresh_token
# REFRESH_COOKIE_SECURE=true  # Mandatory true in staging/pro/prod
REFRESH_COOKIE_SAMESITE=lax  # lax | strict | none (none requires secure=true)
REFRESH_COOKIE_PATH=/api/v1/auth
RATE_LIMIT_ENABLED=true
RATE_LIMIT_MAX_TRACKED_KEYS=10000

# ———————— Session ————————
AUTOFLUSH=false
EXPIRE_ON_COMMIT=false

# ———————— API ————————
API_PREFIX=/api/v1

# ———————— Audit & Logging ————————
LOG_DIR=logs
LOG_TO_FILE=true
LOG_TO_DB=true
